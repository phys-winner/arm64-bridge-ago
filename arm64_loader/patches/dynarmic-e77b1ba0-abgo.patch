+void EmitA32Terminal(oaknut::CodeGenerator& code, EmitContext& ctx, IR::Term::Interpret terminal, IR::LocationDescriptor initial_location, bool) {
+    // MC4 arm32-to-arm64 bridge patch: the A32 frontend emits Interpret for
+    // instructions this backend does not implement (CPS, MRS, LDM user
+    // variants, ...). The upstream x64 backend calls UserCallbacks::
+    // InterpreterFallback here; the arm64 backend has no interpreter, and
+    // asserting aborts the whole process mid-game. Treat the instruction as
+    // a no-op instead: advance past it and return to the dispatcher, which
+    // JITs the next instruction.
+    const A32::LocationDescriptor next{terminal.next};
+    const u32 advance = next.TFlag() ? 2 : 4;
+    code.MOV(Wscratch1, next.PC() + advance);
+    code.STR(Wscratch1, Xstate, offsetof(A32JitState, regs) + sizeof(u32) * 15);
+    EmitRelocation(code, ctx, LinkTarget::ReturnToDispatcher);
 }
 
