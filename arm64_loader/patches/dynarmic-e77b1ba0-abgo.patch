+bool TranslatorVisitor::asimd_VADDHN(bool D, size_t sz, size_t Vn, size_t Vd, bool N, bool M, size_t Vm) {
+    if (sz == 0b11) {
+        return DecodeError();
+    }
+
+    const size_t esize = 8U << sz;
+    const auto d = ToVector(false, Vd, D);
+    const auto m = ToVector(true, Vm, M);
+    const auto n = ToVector(true, Vn, N);
+
+    const auto reg_m = ir.GetVector(m);
+    const auto reg_n = ir.GetVector(n);
+    const auto sum = ir.VectorAdd(2 * esize, reg_n, reg_m);
+    const auto result = ir.VectorNarrow(2 * esize,
+                                        ir.VectorLogicalShiftRight(2 * esize, sum,
+                                                                   static_cast<u8>(esize)));
+    ir.SetVector(d, result);
+    return true;
+}
